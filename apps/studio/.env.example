# DB-related
DB_USERNAME=
DB_PASSWORD=
DB_HOST=
DB_PORT=5433
DB_NAME=

# Optional to set, default is false
# Set to true to print more debug logs
DEBUG=false

# Local dev: skip AWS when testing uploads (presign returns PUT to /api/dev/mock-s3-upload)
# Requires NODE_ENV=development. Set NEXT_PUBLIC_APP_URL to match how you open Studio (e.g. http://localhost:3000).
# ISOMER_DEV_MOCK_S3_UPLOADS=true

# SSM-related
AWS_PROFILE=
SSM_INSTANCE_TARGET=

# Searchsg-related
SEARCHSG_API_KEY="some nonsense string"
# Notification webhook settings
WEBHOOK_API_KEY=
STUDIO_SSM_WEBHOOK_API_KEY=
